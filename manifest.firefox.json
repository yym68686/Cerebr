{
  "manifest_version": 3,
  "default_locale": "en",
  "name": "__MSG_extension_name__",
  "version": "2.6.32",
  "description": "__MSG_extension_description__",
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'",
    "sandbox": "sandbox allow-scripts allow-forms allow-popups allow-modals; script-src 'self' blob: data:; child-src 'self'; object-src 'self'"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": [
    "storage",
    "scripting",
    "webRequest",
    "activeTab",
    "tabs",
    "tabGroups",
    "unlimitedStorage"
  ],
  "optional_permissions": [
    "userScripts"
  ],
  "host_permissions": [
    "<all_urls>",
    "file:///*"
  ],
  "action": {
    "default_title": "__MSG_action_open_sidebar__",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "commands": {
    "toggle_sidebar": {
      "suggested_key": {
        "default": "Alt+Z",
        "windows": "Alt+Z",
        "mac": "MacCtrl+Z"
      },
      "description": "__MSG_command_toggle_sidebar_description__"
    },
    "new_chat": {
      "suggested_key": {
        "default": "Alt+X",
        "windows": "Alt+X",
        "mac": "MacCtrl+X"
      },
      "description": "__MSG_command_new_chat_description__"
    }
  },
  "background": {
    "scripts": [
      "dist/background.js"
    ],
    "type": "module"
  },
  "sandbox": {
    "pages": [
      "dist/src/plugin/guest/shell-plugin-guest.html",
      "dist/src/plugin/guest/page-plugin-guest.html"
    ]
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "dist/content.js"
      ],
      "run_at": "document_start"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "dist/index.html",
        "dist/boot.js",
        "dist/web-manifest.json",
        "dist/v/*",
        "dist/src/host/content/content-script.js",
        "dist/src/plugin/guest/*",
        "dist/styles/*",
        "dist/htmd/*",
        "dist/lib/*",
        "dist/statics/*",
        "dist/icons/*",
        "dist/_locales/*"
      ],
      "matches": [
        "<all_urls>"
      ]
    }
  ],
  "browser_specific_settings": {
    "gecko": {
      "id": "addon@cerebr.app",
      "strict_min_version": "109.0"
    }
  }
}
